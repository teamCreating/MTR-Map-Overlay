{
  "schemaVersion": 1,
  "id": "mtrmap",
  "version": "${version}",
  "name": "MTR Map Overlay",
  "description": "MTR rail, route and station overlays for Xaero's World Map and JourneyMap.",
  "icon": "assets/mtrmap/icon.png",
  "authors": ["BenLi06"],
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.teamcreating.mtrmap.MTRMap"],
    "client": ["io.github.teamcreating.mtrmap.MTRMapClient"],
    "journeymap": ["io.github.teamcreating.mtrmap.integration.journeymap.MTRJourneyMapPlugin"]
  },
  "mixins": ["mtrmap.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21",
    "mtr": "*"
  },
  "suggests": {
    "xaeroworldmap": "*",
    "journeymap": "*"
  }
}
